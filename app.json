{
  "expo": {
    "name": "Curbside",
    "slug": "villagehub-buy-nothing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "villagehubbuynothing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "app.curbside.demo",
      "infoPlist": {
        "NSCameraUsageDescription": "Curbside uses the camera to recognize the item you want to pass on and to scan a neighbor's pickup code.",
        "NSLocationWhenInUseUsageDescription": "Curbside uses your location to show what is nearby. Your exact address is never shown to anyone until you confirm a pickup."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.curbside.demo",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Curbside uses the camera to recognize the item you want to pass on and to scan a neighbor's pickup code."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Curbside uses your location to show what is nearby. Your exact address is never shown to anyone until you confirm a pickup."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
