# Expo uses EXPO_PUBLIC_, not NEXT_PUBLIC_. These values are visible to app users.
# Copy to .env.local. Never add a service-role/secret key to an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Explicit demo preview. false uses real Supabase Auth with no seed data.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_AUTH_REDIRECT_URL=
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=
# Empty redirect URLs use the current web origin or Expo Linking URL.
# For a native development build, use villagehubbuynothing://auth/callback
# and villagehubbuynothing://reset-password instead.

# Keep Phase 1 until the reviewed Phase 2 migration/tests pass.
# Use 2 after Phase 2 verification; use 3 only after Phase 3 approval and tests.
# Use 4 only after ratings migration, worker deployment/configuration and tests.
# Use 5 only after AI migration, Edge deployments and hosted AI tests pass.
# OPENAI_API_KEY belongs in Supabase Edge Function Secrets, never this file.
EXPO_PUBLIC_BACKEND_PHASE=1

# Enable only after the recommendation migration, Edge deployment and tests pass.
EXPO_PUBLIC_RECOMMENDATIONS_ENABLED=false

# Enable after profile photo migration and hosted permission tests pass.
EXPO_PUBLIC_PROFILE_PHOTOS_ENABLED=false
