# Copy to .env and fill in what you have. With nothing filled in, the app runs
# in demo mode: seeded neighbors, on-device data and canned AI results.

# Supabase project (Settings > API). Safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# demo: listings and chat stay on the device, a scripted neighbor plays the other side.
# supabase: listings, claims and chat sync through Supabase.
EXPO_PUBLIC_BACKEND=demo

# Set to mock to turn live scanning off entirely (samples only).
# Leave empty to use the local scan server and/or the scan-item edge function.
EXPO_PUBLIC_AI=

# Live AI without deploying anything: put ONE of these keys here and restart
#   npx expo start            (add --tunnel if the phone isn't on the same Wi-Fi)
# The Expo dev server answers scans itself, so the key stays on your laptop.
# npm run scan-server runs the same scanner on port 8787 for a separate
# machine; point the app at it with EXPO_PUBLIC_SCAN_URL.
# If both keys are set, Gemini is used unless SCAN_PROVIDER=anthropic.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# SCAN_PROVIDER=gemini
# EXPO_PUBLIC_SCAN_URL=http://192.168.1.20:8787

# Center of the demo region. Defaults to Southside Berkeley.
EXPO_PUBLIC_REGION_LAT=37.8676
EXPO_PUBLIC_REGION_LNG=-122.2595
EXPO_PUBLIC_REGION_NAME=Southside

# ------------------------------------------------------------------
# Server side only. Never prefix these with EXPO_PUBLIC_.
#
# Edge function secrets, set with:
#   supabase secrets set ANTHROPIC_API_KEY=... ANTHROPIC_MODEL=...
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
#
# For npm run seed against a live project:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
