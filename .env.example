# Copy to .env and fill in what you have. With nothing filled in, the app runs
# in demo mode: seeded neighbors, on-device data and canned AI results.

# Supabase project (Settings > API). Safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# demo: listings and chat stay on the device, a scripted neighbor plays the other side.
# supabase: listings, claims and chat sync through Supabase.
EXPO_PUBLIC_BACKEND=demo

# Set to mock to force canned scan results even when Supabase is configured.
# Leave empty to use the live scan-item edge function whenever Supabase is set.
EXPO_PUBLIC_AI=

# Center of the demo region. Defaults to Southside Berkeley.
EXPO_PUBLIC_REGION_LAT=37.8676
EXPO_PUBLIC_REGION_LNG=-122.2595
EXPO_PUBLIC_REGION_NAME=Southside

# ------------------------------------------------------------------
# Server side only. Never prefix these with EXPO_PUBLIC_.
#
# Edge function secrets, set with:
#   supabase secrets set ANTHROPIC_API_KEY=... ANTHROPIC_MODEL=...
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
#
# For npm run seed against a live project:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
